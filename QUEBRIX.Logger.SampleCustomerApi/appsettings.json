{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "QUEBRIX.Logger": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "QuebrixLogger": {
    "Url": "http://localhost:8080",
    "ApiKey": "your-api-key",
    "Application": "SampleCustomerApi",
    "Environment": "Development",
    "Tags": ["sample", "demo", "customer-api", "test"],
    "CustomHeaders": {
      "X-Source-Environment": "Development",
      "X-Source-Region": "us-east-1"
    },
    "BatchSize": 50,
    "FlushPeriodSeconds": 5,
    "QueueSize": 10000,
    "TimeoutSeconds": 10,
    "UseCompression": true,
    "EnableBuffering": true,
    "EnableOfflineMode": false,
    "EnableDurableMode": false,
    "MaxRetries": 3,
    "MaxBackoffSeconds": 30
  }
}