    public void Dispose()
    {
        debounceCts?.Cancel();
        debounceCts?.Dispose();
        autoRefreshCts?.Cancel();
        autoRefreshCts?.Dispose();
    }

    // --- Formatting helpers ---
    private static string FormatTimestamp(DateTime? ts)
    {
        if (ts == null) return "-";
        return ts.Value.ToLocalTime().ToString("HH:mm:ss.fff");
    }

    private static string GetRelativeTime(DateTime? ts)
    {
        if (ts == null) return "";
        var diff = DateTime.UtcNow - ts.Value.ToUniversalTime();
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return ts.Value.ToLocalTime().ToString("MMM dd");
    }

    private string GetPageSizeText() => $"{currentPageSize} per page";

    private static string TruncateText(string? text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "-";
        return text.Length <= maxLength ? text : text[..maxLength] + "...";
    }
